		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Filtr języka' =
			
			VAR WybranyJezyk =
			    SELECTEDVALUE('JĘZYK'[Kolumna 1], "PL")
			VAR JezykWiersza =
			    SELECTEDVALUE('Etap dostawy'[PL/EN])
			RETURN
			    IF(JezykWiersza = WybranyJezyk, 1, 0)
		displayFolder: tech
		lineageTag: 8f020b1e-f20c-4365-aff4-405252c706f0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Kolumna 1'
		dataType: string
