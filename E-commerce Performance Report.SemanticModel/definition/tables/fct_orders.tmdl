	column delivery_time_days
		dataType: int64
		formatString: 0
		lineageTag: 53e6b192-15f6-44b0-8f78-93459d5b66b0
		summarizeBy: sum
		sourceColumn: delivery_time_days

		annotation SummarizationSetBy = Automatic

	column 'On time' =
			
			IF(
			    fct_orders[is_delivered] = 1
			        && NOT ISBLANK(fct_orders[order_delivered_customer_date])
			        && NOT ISBLANK(fct_orders[order_estimated_delivery_date]),
			    IF(
			        fct_orders[order_delivered_customer_date]
			            <= fct_orders[order_estimated_delivery_date],
			        1,
			        0
			    ),
			    BLANK()
			)
		formatString: 0
		lineageTag: 078af863-ffdb-4acb-a8ce-81dc833d4b40
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column delay_days =
			IF([On-Time] = 0,
			    DATEDIFF(
			        fct_orders[order_estimated_delivery_date],
			        fct_orders[order_delivered_customer_date],
			        DAY
			    ),BLANK())
		formatString: 0
		lineageTag: e8865093-c682-4632-9668-06fb76cf39fe
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Delivery Time Bins' =
			
			VAR Days =
			    ROUNDUP(fct_orders[delivery_time_days], 0)
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(fct_orders[delivery_time_days]), BLANK(),
			        Days < 0, BLANK(),
			        Days <= 1, "0-1 days",
			        Days <= 3, "2-3 days",
			        Days <= 10, "4-10 days",
			        Days <= 15, "11-15 days",
			        "16+ days"
			    )
		lineageTag: a62f294c-249b-4b2b-8c7f-270048a54153
		summarizeBy: none
		sortByColumn: 'Delivery Time Bins Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Delivery Time Bins Sort' =
			
			VAR Days =
			    ROUNDUP(fct_orders[delivery_time_days], 0)
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(fct_orders[delivery_time_days]), BLANK(),
			        Days < 0, BLANK(),
			        Days <= 1, 1,
			        Days <= 3, 2,
			        Days <= 10, 3,
			        Days <= 15, 4,
			        5
			    )
		formatString: 0
		lineageTag: bc5bbf88-1aa3-42a8-ab2d-104bf7425be8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Approval Hours' =
			
			DATEDIFF(
			    fct_orders[order_purchase_timestamp],
			    fct_orders[order_approved_at],
			    HOUR
			)
		formatString: 0
		lineageTag: a1e0dc7c-1008-4ba2-ac09-65ddbb99a103
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Preparation Hours' =
			
			DATEDIFF(
			    fct_orders[order_approved_at],
			    fct_orders[order_delivered_carrier_date],
			    HOUR
			)
		formatString: 0
		lineageTag: 1a511579-47d4-47b2-8c98-893945a52396
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Carrier Hours' =
			
			DATEDIFF(
			    fct_orders[order_delivered_carrier_date],
			    fct_orders[order_delivered_customer_date],
			    HOUR
			)
		formatString: 0
		lineageTag: 35c68507-e226-4b61-8cea-00e8dc0988f2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

